@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
# NOTE: schema.org's OWN JSON-LD @context (whether referenced as
# "https://schema.org" or "https://schema.org/") resolves its terms to the
# http:// (not https://) namespace for legacy compatibility -- this is a
# well-known schema.org quirk, confirmed here by actually parsing a test
# payload with rdflib and inspecting the resulting triples. Using
# https://schema.org/ in these shapes would silently match NOTHING and
# every validation would vacuously "pass" -- exactly the silent-failure
# class this validator exists to prevent. Do not "fix" this to https
# without re-verifying against how your actual page JSON-LD resolves its
# @context.
@prefix ag:     <https://schema-validator.maloriedelilah.internal/shapes/author-geo#> .

#
# author-geo.shacl.ttl
# ====================
# SHACL shapes for the author-geo content model. START MINIMAL: this file
# encodes ONLY what SLICE-01/02/03 exercise -- Book, Person, WebSite, and
# the DD-001 cross-reference-resolution rule. It is expected to grow (more
# schema.org types: BreadcrumbList, ImageObject, etc.) as the content model
# does; do not treat the entities covered here as exhaustive.
#
# All shapes use sh:Violation severity: any finding here should fail a
# build/CI gate, not just warn.
#

# ------------------------------------------------------------------------
# DD-001 -- cross-reference resolution (THE CRITICAL RULE)
# ------------------------------------------------------------------------
# In JSON-LD it is trivially easy to write a syntactically valid @id
# reference (e.g. {"@id": "https://example.com/about#author"}) that points
# to NOTHING -- no node in the graph actually defines that subject. This
# is the exact silent-failure class this validator exists to catch: the
# page *parses*, the reference *looks* right, but the linked entity simply
# isn't there.
#
# ag:DefinedNodeShape below is a small, reusable shape asserting "this node
# has at least one rdf:type triple somewhere in the graph" -- i.e. it is
# actually DEFINED, not merely referenced. A dangling @id, by construction,
# has no triples of its own (nothing else in the document describes it),
# so it has no rdf:type and fails this shape.
#
# We apply ag:DefinedNodeShape (via sh:node) to every property whose value
# is expected to be a cross-referenced entity: Book.author, WebSite.publisher.
# We ALSO apply sh:class schema:Person on those same properties to assert
# the specific expected type. The two checks are conceptually distinct even
# though, mechanically, both key off the presence/absence of an rdf:type
# triple for the referenced node under SHACL's default (no-reasoning)
# semantics:
#   - sh:node ag:DefinedNodeShape  -> "this reference resolves to *something*
#     defined in the graph" (the generic DD-001 check -- catches dangling
#     refs regardless of what type they were supposed to be).
#   - sh:class schema:Person       -> "and that something is specifically a
#     Person" (the domain-specific type check).
# Keeping both means a future author/publisher shape that targets a
# different class still inherits the DD-001 dangling-reference protection
# for free by reusing ag:DefinedNodeShape.
ag:DefinedNodeShape
    a sh:NodeShape ;
    sh:property [
        sh:path rdf:type ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "This node is referenced (by @id) but is not defined anywhere in the graph -- it has no rdf:type triple. This is a dangling cross-reference (DD-001)."@en ;
    ] .

# ------------------------------------------------------------------------
# Person
# ------------------------------------------------------------------------
ag:PersonShape
    a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "schema:Person must have a schema:name."@en ;
    ] .

# ------------------------------------------------------------------------
# Book -- DD-005: PRIMARY Book vs EDITION.
# ------------------------------------------------------------------------
# DD-005 draws a line between the PRIMARY (canonical) Book and its EDITIONS:
#   - The PRIMARY Book is the canonical work. It owns the single on-site
#     canonical schema:url (its own page), a name, and author(s). In the
#     emitted JSON-LD it is the IRI-identified Book (has an @id ending
#     #book); it is a top-level @graph member, NOT the object of a
#     schema:workExample.
#   - An EDITION (hardcover / ebook / audiobook) is a manifestation of the
#     work, emitted as an ANONYMOUS (blank-node) schema:Book that is the
#     OBJECT OF schema:workExample. Editions are identified by format-level
#     facts (bookFormat, isbn) and carry retailer buy-links as schema:Offer
#     (Offer.url), NOT a Book.url -- because a retailer link is a purchase
#     point, not a canonical page, and one edition may have many buy-links.
#
# Therefore we do NOT police every schema:Book with the strict
# name/url/author requirements (that would force editions to fabricate a
# name/url/author they legitimately don't have -- the "rewrite the payload
# to pass the validator" anti-pattern). We split into two shapes:
#   ag:PrimaryBookShape -> strict (name, url, author), targeted ONLY at
#                          IRI-identified Books via a SPARQL target.
#   ag:EditionShape     -> light (bookFormat + a well-formed Offer),
#                          targeted at the objects of schema:workExample.

# PRIMARY vs STUB Book (added when collection pages -- series, themes/hubs --
# began referencing books as NAMED STUBS). A named stub is an IRI-identified
# schema:Book that carries @id + name but deliberately NOT url/author/editions
# (DD-001: a cross-page reference must resolve standalone, so it is a typed +
# named node, not a bare @id -- but it is a REFERENCE, not the canonical
# definition). The canonical Book is defined once on its OWN page with full
# fields. So targeting "every IRI Book" for the strict shape WRONGLY fails the
# stubs (they legitimately lack url/author).
#
# THE PARTITION (per-page validation): on a book's own page the Book is never
# the object of a collection membership predicate; on a series/hub page the
# stub ALWAYS is -- BookSeries.hasPart -> {@id} (series) and
# ItemList/ListItem.item -> {@type:Book,@id,name} (themes/hubs). So:
#   PRIMARY  = IRI Book NOT referenced as a collection member  -> strict shape.
#   STUB     = IRI Book referenced as a collection member       -> light shape.
# The two SPARQL targets are EXACT logical complements (NOT EXISTS vs its
# EXISTS negation over the same predicates): their union is provably ALL IRI
# Books and their intersection is empty, so nothing falls through BOTH (which
# would be a vacuous pass) and nothing is caught by BOTH. We deliberately do
# NOT discriminate by "has a url/workExample" -- that entangles the target with
# a property the shape itself checks, relocating the vacuous-pass hole (a
# canonical Book that legitimately lacks that property would drop out of
# validation entirely instead of failing). (ITB's SHACL engine is
# Jena/TopBraid, which supports sh:target + sh:SPARQLTarget.)
ag:PrimaryBookShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        # PREFIX must be declared INSIDE the query: a SPARQL target does NOT
        # inherit the Turtle document's @prefix bindings. Without this,
        # `schema:Book` is an unknown prefix, the query matches NOTHING, and
        # the whole PrimaryBookShape passes VACUOUSLY -- the exact silent
        # "match nothing => vacuous pass" failure this validator exists to
        # catch (verified: without the PREFIX line, dangled-author and
        # missing-url primary Books both wrongly conformed).
        # NOTE http:// namespace, not https:// -- schema.org's @context
        # resolves terms to http://schema.org/ (see file header); https would
        # match nothing.
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT ?this WHERE {
                ?this a schema:Book .
                FILTER (isIRI(?this))
                FILTER NOT EXISTS { ?s schema:hasPart ?this }
                FILTER NOT EXISTS { ?li schema:item ?this }
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "The primary schema:Book must have a schema:name."@en ;
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "The primary schema:Book must have a schema:url (its single on-site canonical page URL -- DD-005)."@en ;
    ] ;
    sh:property [
        sh:path schema:author ;
        sh:minCount 1 ;
        # DD-001 dangling-reference protection: the author reference must
        # resolve to a node actually DEFINED in the graph (has an rdf:type).
        # A named stub {@type:Person, @id, name} SATISFIES this -- it carries
        # its own rdf:type + name -- so the DD-001 "define once on /about,
        # reference by @id + named stub everywhere" model passes here, while
        # a bare {@id} that nothing else defines still FAILS. (DD-001 + #1.)
        sh:node ag:DefinedNodeShape ;
        sh:class schema:Person ;
        sh:severity sh:Violation ;
        sh:message "The primary schema:Book.author must be present and must resolve to a schema:Person node defined in the graph -- a named stub {@type:Person,@id,name} counts; a dangling @id does not (DD-001)."@en ;
    ] .

# STUB Book: an IRI Book referenced as a collection member (object of
# schema:hasPart on a series, or schema:item under an ItemList on a hub/theme).
# This is the EXACT logical complement of PrimaryBookShape's target -- their
# union is all IRI Books, their intersection empty. A stub must carry a name
# (so the reference is human/machine-meaningful, not a bare @id -- DD-001); it
# deliberately does NOT require url/author/editions (those live on the book's
# own canonical page). If BOTH shapes ever matched the same node it would be a
# bug in this partition; if NEITHER matched, that node would escape validation
# -- the complementary NOT EXISTS/EXISTS construction makes both impossible.
ag:StubBookShape
    a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            SELECT ?this WHERE {
                ?this a schema:Book .
                FILTER (isIRI(?this))
                FILTER ( EXISTS { ?s schema:hasPart ?this }
                      || EXISTS { ?li schema:item ?this } )
            }
        """ ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A referenced (stub) schema:Book must carry a schema:name -- a bare @id is a dangling reference (DD-001). Its full definition (url, author, editions) lives on the book's own page."@en ;
    ] .

# EDITION: the objects of schema:workExample. Light, edition-appropriate
# checks -- a format, and if an Offer is present it must carry a url.
# (bookFormat required; author/url/name intentionally NOT required here.)
ag:EditionShape
    a sh:NodeShape ;
    sh:targetObjectsOf schema:workExample ;
    sh:property [
        sh:path schema:bookFormat ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Book edition (schema:workExample) must state its schema:bookFormat (DD-005)."@en ;
    ] ;
    sh:property [
        sh:path ( schema:offers schema:url ) ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Book edition's schema:Offer must carry a schema:url (the retailer buy-link -- DD-005)."@en ;
    ] .

# ------------------------------------------------------------------------
# WebSite
# ------------------------------------------------------------------------
ag:WebSiteShape
    a sh:NodeShape ;
    sh:targetClass schema:WebSite ;
    sh:property [
        sh:path schema:publisher ;
        sh:minCount 1 ;
        # DD-001: same dangling-reference protection as Book.author above.
        sh:node ag:DefinedNodeShape ;
        sh:class schema:Person ;
        sh:severity sh:Violation ;
        sh:message "schema:WebSite.publisher must be present, must resolve to a node defined in the graph (not a dangling @id reference), and that node must be a schema:Person."@en ;
    ] .
